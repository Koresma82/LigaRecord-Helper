# Copia para worker/.env (local) ou cola cada uma no Railway > Variables.
# ---------------------------------------------------------------------------

# --- OBRIGATORIAS ----------------------------------------------------------

# dev | test | prod
# Decide em que documento do Firestore o worker le e escreve.
# Local usa dev; o Railway usa prod.
AMBIENTE=dev

# O JSON da conta de servico do Firebase, INTEIRO e numa linha so.
# Consola Firebase > Definicoes do projeto > Contas de servico >
# Gerar nova chave privada.
FIREBASE_SERVICE_ACCOUNT=

# O teu uid do Firebase. Authentication > Users > User UID,
# depois de fazeres login na app uma vez.
UID_DONO=

# --- TELEGRAM (opcional, mas e para isto que o worker existe) --------------

# Fala com o @BotFather no Telegram: /newbot
TELEGRAM_TOKEN=

# Deixa vazio na primeira vez. Manda /start ao bot e ele diz-te o numero.
# Sem isto o bot responde a QUALQUER pessoa que descubra o username.
TELEGRAM_CHAT_ID=

# --- OPCIONAIS -------------------------------------------------------------

# Jornada da Primeira Liga. Normalmente e lida do zerozero; so preenche
# para forcar um valor.
# LR_JORNADA=

# Edicao e fase do zerozero. MUDAM NO INICIO DE CADA EPOCA: abre
# zerozero.pt/competicao/liga-portuguesa e le os numeros do URL.
# ZZ_EDICAO=liga-portugal-betclic-2026-27/218294
# ZZ_FASE=240072

# Numero da tua equipa na Liga Record. So e usado para ler a ronda e o
# contador do fecho.
LR_ID_TEAM=175907

# Salta o zerozero e usa directamente o maisfutebol. So para testar em local
# o caminho que o Railway vai correr (la o zerozero devolve sempre 403).
# FORCAR_ALTERNATIVA=1

# --- DUVIDAS POR IA (opcional) -----------------------------------------
# Uma chamada por JORNADA (nao por dia) a API da Anthropic com pesquisa web,
# para procurar noticias sobre os teus jogadores. Sem esta chave a funcao
# fica desligada e o resto corre na mesma.
# A chave e de console.anthropic.com — e faturada a parte da subscricao.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-sonnet-5
