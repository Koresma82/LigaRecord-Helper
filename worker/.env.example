# Copia para worker/.env (local) ou cola cada uma no Railway > Variables.

# --- Liga Record -------------------------------------------------------------
# O login e email + palavra-passe no dominio deles, por isso o worker
# autentica-se sozinho. O cookie de sessao dura menos de um dia, o que torna
# a captura manual inviavel — tem mesmo de ser assim.
LR_EMAIL=
LR_PASSWORD=

# O numero no fim do URL do teu plantel:
#   liga.record.pt/gerir-equipas/plantel.aspx?id_team=XXXXXX
LR_ID_TEAM=

# So preencher se o formulario de login estiver noutro sitio.
# LR_URL_LOGIN=

# dev | test | prod — decide onde o worker escreve. Local e sempre dev,
# senao apagas os dados que estas a usar no telemovel.
AMBIENTE=dev

# --- Firebase ----------------------------------------------------------------
# Consola Firebase > Definicoes do projeto > Contas de servico >
# Gerar nova chave privada. Cola o JSON INTEIRO aqui, numa linha so.
FIREBASE_SERVICE_ACCOUNT=

# O teu uid. Firebase Auth > Users > User UID, depois do primeiro login.
UID_DONO=

# --- Telegram (opcional) -----------------------------------------------------
TELEGRAM_TOKEN=
# Deixa vazio na primeira execucao, manda /start ao bot, e ele diz-te o id.
TELEGRAM_CHAT_ID=
