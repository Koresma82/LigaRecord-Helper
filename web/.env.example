# Copia para web/.env.local. Estes valores sao publicos por desenho: aparecem
# no bundle. Quem protege os dados sao as regras do Firestore.
#
# Onde os encontrar: Consola Firebase > Definicoes do projeto >
# As tuas apps > Configuracao do SDK.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# dev | test | prod — decide que documento do Firestore a app le.
# Local e sempre dev. No Netlify vem do netlify.toml, nao daqui.
VITE_AMBIENTE=dev
